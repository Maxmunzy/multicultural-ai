<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="38dp"
            android:paddingEnd="20dp"
            android:paddingBottom="22dp"
            android:background="@drawable/bg_header">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="학부모 화면"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VI"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/bg_badge" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="수신함 + 분석 결과"
                android:textColor="#DDFFFFFF"
                android:textSize="16sp"
                android:paddingTop="6dp" />
        </LinearLayout>

        <!-- Status pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#1E40AF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:background="@drawable/bg_status_pill" />
        </LinearLayout>

        <!-- Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="4dp"
            android:paddingEnd="18dp">

            <EditText
                android:id="@+id/etParentId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="parent_id"
                android:text="parent_001"
                android:singleLine="true"
                android:textSize="16sp"
                android:textColor="#1E2937"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:background="@drawable/bg_input"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnLoadInbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="수신함 불러오기"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/bg_btn_primary"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnDemo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="서버 응답 없을 때 데모 결과 보기"
                android:textColor="#1E40AF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/bg_btn_outline"
                android:layout_marginBottom="12dp" />

            <!-- Inbox list card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_card_white"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="가정통신문 목록"
                    android:textColor="#64748B"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingBottom="10dp" />

                <TextView
                    android:id="@+id/tvInboxList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="수신함을 불러오세요."
                    android:textColor="#475569"
                    android:textSize="16sp"
                    android:lineSpacingMultiplier="1.25" />

                <LinearLayout
                    android:id="@+id/lvInboxList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Selected notice card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_card_blue"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="선택한 가정통신문"
                    android:textColor="#64748B"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingBottom="10dp" />

                <TextView
                    android:id="@+id/tvSelectedNotice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="선택된 가정통신문이 없습니다."
                    android:textColor="#475569"
                    android:textSize="16sp"
                    android:lineSpacingMultiplier="1.25" />
            </LinearLayout>

            <Button
                android:id="@+id/btnAnalyze"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="분석하기"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/bg_btn_primary"
                android:layout_marginBottom="12dp" />

            <!-- 탭 버튼 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnTabAnalysis"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="분석 결과"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:background="@drawable/bg_btn_primary"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnTabFeedback"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="피드백"
                    android:textColor="#1E40AF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:background="@drawable/bg_btn_outline" />
            </LinearLayout>

            <!-- 분석 결과 탭 -->
            <LinearLayout
                android:id="@+id/layoutAnalysis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_white"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="분석 결과"
                        android:textColor="#64748B"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnZoomOut"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:text="A-"
                        android:textColor="#1E40AF"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:padding="0dp"
                        android:background="@drawable/bg_btn_outline"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnZoomIn"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:text="A+"
                        android:textColor="#1E40AF"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:padding="0dp"
                        android:background="@drawable/bg_btn_outline" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAnalysisResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="분석 결과가 없습니다."
                    android:textColor="#1E2937"
                    android:textSize="16sp"
                    android:lineSpacingMultiplier="1.25" />
            </LinearLayout>

            <!-- 피드백 탭 -->
            <LinearLayout
                android:id="@+id/layoutFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_white"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="피드백 (용어 검수)"
                        android:textColor="#64748B"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnZoomOutFeedback"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:text="A-"
                        android:textColor="#1E40AF"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:padding="0dp"
                        android:background="@drawable/bg_btn_outline"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnZoomInFeedback"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:text="A+"
                        android:textColor="#1E40AF"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:padding="0dp"
                        android:background="@drawable/bg_btn_outline" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="분석 후 피드백이 표시됩니다."
                    android:textColor="#1E2937"
                    android:textSize="16sp"
                    android:lineSpacingMultiplier="1.25" />
            </LinearLayout>

            <Button
                android:id="@+id/btnPlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="베트남어로 듣기"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/bg_btn_primary"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnAiAssistant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✨ AI 어시스턴트에게 물어보기"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/bg_btn_ai"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnBack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="처음으로"
                android:textColor="#1E40AF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/bg_btn_outline"
                android:layout_marginBottom="12dp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
