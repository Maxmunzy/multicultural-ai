<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:text="OCR 실험"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"/>

    <!-- 실험 1: PDF 파일 직접 선택 -->
    <Button
        android:id="@+id/btnGallery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="실험1: PDF 파일 선택 (HWP→PDF 변환본)"/>

    <!-- 실험 2~4: 카메라 직접 촬영 + 조건 선택 -->
    <Button
        android:id="@+id/btnCamera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="실험2~4: 카메라로 직접 촬영"/>

    <!-- 카메라 조건 선택 (촬영 전 선택) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCond1"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="정면"
            android:textSize="13sp"
            android:backgroundTint="#2196F3"/>

        <Button
            android:id="@+id/btnCond2"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="기울임"
            android:textSize="13sp"
            android:backgroundTint="#AAAAAA"/>

        <Button
            android:id="@+id/btnCond3"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="구겨짐"
            android:textSize="13sp"
            android:backgroundTint="#AAAAAA"/>
    </LinearLayout>

    <!-- 상태 표시 -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="버튼을 눌러 실험을 시작하세요"
        android:textColor="#888888"/>

    <!-- 이미지 미리보기 -->
    <ImageView
        android:id="@+id/ivPreview"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="8dp"
        android:scaleType="centerInside"
        android:background="#F0F0F0"/>

    <!-- OCR 결과 (수정 가능) -->
    <EditText
        android:id="@+id/etResult"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:gravity="top"
        android:hint="OCR 추출 결과가 여기에 표시됩니다"
        android:inputType="textMultiLine"
        android:scrollbars="vertical"
        android:background="#FAFAFA"
        android:padding="8dp"/>

    <!-- 버튼 행: 복사 + 이미지 저장 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCopy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="텍스트 복사"/>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="이미지 저장"/>
    </LinearLayout>

</LinearLayout>
